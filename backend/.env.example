# Variables de entorno del backend CosmoSchools para el servidor.
# Copiar como .env (u otro mecanismo del servidor) y completar. NUNCA subir el archivo real a git.

# --- Base de datos (MySQL 8) ---
# La base debe existir (vacía); las tablas las crea la app al arrancar.
# Con MySQL en el mismo servidor sin SSL hace falta allowPublicKeyRetrieval=true;
# con un MySQL remoto/administrado usar useSSL=true en su lugar.
DB_URL=jdbc:mysql://localhost:3306/cosmo_schools?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=cosmo_app
DB_PASSWORD=cambiar-por-una-contrasena-segura

# --- Seguridad ---
# Secreto para firmar los JWT: mínimo 32 caracteres, aleatorio. Generar con: openssl rand -base64 48
# Si se cambia, todos los usuarios quedan deslogueados (es normal).
JWT_SECRET=
# Duración del access token (30 min) y del refresh token (7 días), en milisegundos. Opcionales.
#JWT_EXPIRATION_MS=1800000
#JWT_REFRESH_EXPIRATION_MS=604800000

# Dominio exacto del frontend: con https://, sin "/" al final. Varios separados por coma.
CORS_ALLOWED_ORIGINS=https://cosmo.ejemplo.com

# Ocultar la documentación Swagger en producción.
SWAGGER_ENABLED=false

# --- Primer administrador ---
# Solo se usa al arrancar si NO existe ningún ADMIN. Contraseña de mínimo 8 caracteres.
# Después del primer arranque se pueden quitar estas variables.
ADMIN_EMAIL=admin@ejemplo.com
ADMIN_PASSWORD=
ADMIN_NOMBRE=Administrador

# --- Varios ---
# Puerto HTTP de la app (por defecto 8085). Debe quedar interno, detrás de Nginx.
PORT=8085
# No imprimir cada consulta SQL en los logs.
SHOW_SQL=false
# Zona horaria usada para horas límite y avisos de atraso (por defecto America/Bogota).
APP_TIMEZONE=America/Bogota
